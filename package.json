{
  "name": "photo-slap",
  "private": true,
  "version": "1.10.0",
  "description": "Retro-styled photo & video slideshow with duplicate finder",
  "author": "Eddy Sant <eddysant@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "verify": "tsc && vite build",
    "build:dir": "tsc && vite build && electron-builder --dir",
    "build": "tsc && vite build && electron-builder",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:folder": "node scripts/check-folder.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:smoke": "node scripts/smoke-packaged.mjs",
    "preview": "vite preview",
    "start": "open release/0.0.0/mac-arm64/photo-slap.app",
    "test:memory": "node scripts/memory.mjs"
  },
  "dependencies": {
    "blockhash-core": "^0.1.0",
    "electron-store": "^12.0.0",
    "exifreader": "^4.41.0",
    "fast-glob": "^3.3.3",
    "framer-motion": "^14.14.0",
    "heic-decode": "^2.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^45.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.1.2"
  },
  "main": "dist-electron/main.js"
}
